# Copy to .env at the repository root. Never commit .env or access tokens.
COBRI_APP_NAME=Cobri

# Live OIDC configuration is pending. Set all three fields together.
COBRI_AUTH_ISSUER=
COBRI_AUTH_AUDIENCE=
COBRI_AUTH_JWKS_URL=
COBRI_AUTH_ALGORITHMS=["RS256"]
COBRI_AUTH_JWKS_TIMEOUT_SECONDS=5
COBRI_AUTH_JWKS_CACHE_SECONDS=300
COBRI_AUTH_CLOCK_SKEW_SECONDS=0

# Future integration settings: comments only; no adapter consumes these yet.
# Mohamed adds DATABASE_URL and queue settings after choosing the implementation.
# Asser adds GROQ_API_KEY / OPENROUTER_API_KEY and model settings with his gateway.
