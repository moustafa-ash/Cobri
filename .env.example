# Copy to .env at the repository root. Never commit .env or access tokens.
COBRI_APP_NAME=Cobri

# Live OIDC configuration is pending. Set all three fields together.
COBRI_AUTH_ISSUER=
COBRI_AUTH_AUDIENCE=
COBRI_AUTH_JWKS_URL=
COBRI_AUTH_ALGORITHMS=["RS256"]
COBRI_AUTH_JWKS_TIMEOUT_SECONDS=5
COBRI_AUTH_JWKS_CACHE_SECONDS=300
COBRI_AUTH_CLOCK_SKEW_SECONDS=0

# Local development uses SQLite. Production may use PostgreSQL with the same
# SQLAlchemy repositories, for example:
# COBRI_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/cobri
COBRI_DATABASE_URL=sqlite+aiosqlite:///./.data/cobri.db
COBRI_AUTO_CREATE_SCHEMA=true
COBRI_CONTENT_ROOT=content-packages
COBRI_SANDBOX_ENABLED=false
COBRI_SANDBOX_IMAGE=python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
COBRI_SANDBOX_TIMEOUT_SECONDS=3

# Choose fixture only for deterministic development/tests. The learner flow uses provider.
# Provider mode without at least one provider key fails as infrastructure, without a verdict.
COBRI_GROQ_API_KEY=
COBRI_GROQ_BASE_URL=https://api.groq.com/openai/v1
COBRI_GROQ_MODEL=openai/gpt-oss-20b
COBRI_OPENROUTER_API_KEY=
COBRI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COBRI_OPENROUTER_MODEL=openrouter/free
COBRI_MODEL_TIMEOUT_SECONDS=30
COBRI_EVALUATION_MODE=fixture
COBRI_CORS_ORIGINS=["http://localhost:5173"]
COBRI_MAX_REQUEST_BYTES=32768
COBRI_RATE_LIMIT_PER_MINUTE=120

# Semantic retrieval is disabled until an immutable model revision is approved
# and the local model files are installed.
COBRI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
COBRI_EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Optional explicit local cache; otherwise .data/models/<model>-<revision> is used.
COBRI_EMBEDDING_MODEL_PATH=
COBRI_EMBEDDING_INDEX_PATH=.data/semantic-index.json
COBRI_EMBEDDING_DIMENSIONS=384
COBRI_EMBEDDING_MIN_SCORE=0.8
COBRI_TAVILY_API_KEY=
COBRI_TAVILY_MAX_RESULTS=3
COBRI_TAVILY_TIMEOUT_SECONDS=5
